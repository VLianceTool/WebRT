<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Spinview</title>

<meta
    name="viewport"
    content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"
>
<meta name="theme-color" content="#000000">

<link rel="icon" href="data:,">
<script src="version.js"></script>

<style>
html,
body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    overflow:hidden;
    background:#000;
}

body{
    position:fixed;
    inset:0;
    touch-action:none;
    overscroll-behavior:none;
    -webkit-text-size-adjust:100%;
    text-size-adjust:100%;
    font-family:Arial,Helvetica,sans-serif;
}

.game-canvas{
    position:fixed;
    inset:0;
    display:block;
    width:100%;
    height:100%;
    margin:0;
    padding:0;
    border:0;
    outline:none;
    background:#000;
    z-index:0;
}

.app-loader{
    position:fixed;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    color:#fff;
    background:#0a0a0a;
    z-index:50;
}

.app-spinner{
    width:40px;
    height:40px;
    margin-bottom:12px;
    border:4px solid rgba(255,255,255,.15);
    border-top-color:#fff;
    border-radius:50%;
    animation:spin 1s linear infinite;
}

@keyframes spin{
    to{
        transform:rotate(360deg);
    }
}

.debug-console{
    position:fixed;
    left:10px;
    right:10px;
    bottom:48px;
    display:none;
    max-height:50vh;
    overflow:auto;
    box-sizing:border-box;
    padding:10px;
    color:#a8efa8;
    background:rgba(0,0,0,.94);
    border:1px solid rgba(255,255,255,.18);
    border-radius:8px;
    font:12px/1.4 Consolas,Monaco,monospace;
    white-space:pre-wrap;
    word-break:break-word;
    user-select:text;
    -webkit-user-select:text;
    z-index:100;
}

.debug-console.visible{
    display:block;
}

.debug-console.has-error{
    color:#ff9b9b;
    border-color:rgba(255,90,90,.75);
}

.debug-button{
    position:fixed;
    right:8px;
    bottom:8px;
    display:none;
    min-width:44px;
    height:28px;
    padding:0 8px;
    color:#fff;
    background:rgba(22,22,22,.84);
    border:1px solid rgba(255,255,255,.35);
    border-radius:5px;
    font:700 11px Arial,Helvetica,sans-serif;
    z-index:110;
}

.debug-button.visible{
    display:block;
}

.debug-button.has-error{
    background:rgba(120,0,0,.84);
    border-color:rgba(255,100,100,.85);
}
</style>
</head>

<body>

<div class="app-loader" id="loader">
    <div class="app-spinner"></div>
    <div id="loaderText">Loading engine...</div>
</div>

<div class="debug-console" id="debugConsole"></div>

<button
    class="debug-button"
    id="debugButton"
    type="button">
    ...
</button>

<canvas
    class="game-canvas"
    id="canvas"
    tabindex="0"
    oncontextmenu="event.preventDefault()">
</canvas>

<script>
(function(){
    "use strict";

    var ALWAYS_SHOW_DEBUG_BUTTON = true;
    var MAX_LOG_LINES = 400;

    var canvas = document.getElementById("canvas");
    var loader = document.getElementById("loader");
    var loaderText = document.getElementById("loaderText");
    var debugConsole = document.getElementById("debugConsole");
    var debugButton = document.getElementById("debugButton");

    var nativeLog =
        console.log ?
        console.log.bind(console) :
        function(){};

    var nativeInfo =
        console.info ?
        console.info.bind(console) :
        nativeLog;

    var nativeWarn =
        console.warn ?
        console.warn.bind(console) :
        nativeLog;

    var nativeError =
        console.error ?
        console.error.bind(console) :
        nativeLog;

    var debugVisible = false;
    var debugMode = false;
    var showDebugButton = false;
    var logLineCount = 0;

    function isLocalDevelopmentHost(){
        var host = location.hostname;

        return (
            host === "localhost" ||
            host === "127.0.0.1" ||
            host === "::1" ||
            host.indexOf("192.168.") === 0
        );
    }

    function hasDebugParameter(){
        return /(?:^|[?&])debug(?:[=&]|$)/i.test(location.search);
    }

    debugMode =
        hasDebugParameter() ||
        isLocalDevelopmentHost() ||
        window.spinviewDebugEnabled === true;

    showDebugButton =
        ALWAYS_SHOW_DEBUG_BUTTON ||
        debugMode;

    function currentVersion(){
        if(typeof window.getCurrentVersion === "function"){
            return window.getCurrentVersion();
        }

        try{
            return (
                new URL(location.href).searchParams.get("_v") ||
                localStorage.getItem("siteVersion") ||
                "dev"
            );
        }
        catch(error){
            return "dev";
        }
    }

    function updateVersionLabels(){
        var version = currentVersion();

        document.title = "Spinview " + version;

        if(debugButton){
            debugButton.textContent = version;
        }

        if(loaderText){
            loaderText.textContent =
                "Loading engine... " + version;
        }
    }

    window.spinviewUpdateVersionLabel =
        updateVersionLabels;

    function showDebug(){
        debugVisible = true;
        debugConsole.classList.add("visible");
    }

    function hideDebug(){
        debugVisible = false;
        debugConsole.classList.remove("visible");
    }

    function toggleDebug(){
        if(debugVisible){
            hideDebug();
        }
        else{
            showDebug();
        }
    }

    function valueToString(value){
        if(value === undefined){
            return "undefined";
        }

        if(value === null){
            return "null";
        }

        if(typeof value === "string"){
            return value;
        }

        if(value instanceof Error){
            return (
                value.stack ||
                value.message ||
                String(value)
            );
        }

        if(typeof value === "object"){
            try{
                return JSON.stringify(value);
            }
            catch(error){
                return String(value);
            }
        }

        return String(value);
    }

    function appendLog(level,args){
        var parts = [];
        var line;
        var i;

        for(i = 0; i < args.length; ++i){
            parts.push(valueToString(args[i]));
        }

        line = document.createElement("div");
        line.textContent = parts.join(" ");

        debugConsole.appendChild(line);
        logLineCount++;

        while(
            logLineCount > MAX_LOG_LINES &&
            debugConsole.firstChild
        ){
            debugConsole.removeChild(
                debugConsole.firstChild
            );

            logLineCount--;
        }

        debugConsole.scrollTop =
            debugConsole.scrollHeight;

        if(level === "error"){
            debugConsole.classList.add("has-error");

            debugButton.classList.add(
                "visible",
                "has-error"
            );

            /*
                Only open automatically in explicit/local debug mode.
                ALWAYS_SHOW_DEBUG_BUTTON only keeps the button visible.
            */
            if(debugMode){
                showDebug();
            }
        }
    }

    console.log = function(){
        var args =
            Array.prototype.slice.call(arguments);

        appendLog("log",args);
        nativeLog.apply(null,args);
    };

    console.info = function(){
        var args =
            Array.prototype.slice.call(arguments);

        appendLog("info",args);
        nativeInfo.apply(null,args);
    };

    console.warn = function(){
        var args =
            Array.prototype.slice.call(arguments);

        appendLog("warn",args);
        nativeWarn.apply(null,args);
    };

    console.error = function(){
        var args =
            Array.prototype.slice.call(arguments);

        appendLog("error",args);
        nativeError.apply(null,args);
    };

    debugButton.addEventListener(
        "pointerdown",
        function(event){
            event.preventDefault();
            event.stopPropagation();

            if(window.spinviewDeactivateKeyboard){
                window.spinviewDeactivateKeyboard();
            }

            if(document.activeElement === canvas){
                canvas.blur();
            }

            toggleDebug();
        }
    );

    document.addEventListener(
        "pointerdown",
        function(event){
            if(!debugVisible){
                return;
            }

            if(
                debugConsole.contains(event.target) ||
                event.target === debugButton
            ){
                return;
            }

            hideDebug();
        }
    );

    window.addEventListener(
        "error",
        function(event){
            console.error(
                "[error]",
                event.message || "Unknown JavaScript error",
                event.filename || "",
                event.lineno || 0,
                event.colno || 0,
                event.error ?
                    event.error.stack || event.error :
                    ""
            );
        }
    );

    window.addEventListener(
        "unhandledrejection",
        function(event){
            console.error(
                "[unhandledrejection]",
                event.reason
            );
        }
    );

    canvas.addEventListener(
        "webglcontextlost",
        function(event){
            event.preventDefault();

            console.error(
                "[webgl] Context lost."
            );
        },
        false
    );

    canvas.addEventListener(
        "webglcontextrestored",
        function(){
            console.warn(
                "[webgl] Context restored."
            );
        },
        false
    );

    function resizeCanvasCssOnly(){
        canvas.style.width =
            window.innerWidth + "px";

        canvas.style.height =
            window.innerHeight + "px";
    }

    window.addEventListener(
        "load",
        resizeCanvasCssOnly
    );

    window.addEventListener(
        "resize",
        resizeCanvasCssOnly
    );

    window.addEventListener(
        "orientationchange",
        function(){
            setTimeout(resizeCanvasCssOnly,50);
            setTimeout(resizeCanvasCssOnly,250);
            setTimeout(resizeCanvasCssOnly,500);
        }
    );

    function probeWebGLSupport(){
        var testCanvas =
            document.createElement("canvas");

        var attributes = {
            alpha:false,
            antialias:false,
            depth:true,
            stencil:true,
            preserveDrawingBuffer:false,
            powerPreference:"high-performance",
            failIfMajorPerformanceCaveat:false
        };

        var gl = null;

        testCanvas.width = 16;
        testCanvas.height = 16;

        try{
            gl = testCanvas.getContext(
                "webgl2",
                attributes
            );
        }
        catch(error){
            console.error(
                "[webgl] WebGL2 probe failed.",
                error
            );
        }

        if(!gl){
            console.error(
                "[webgl] WebGL2 is required."
            );

            return;
        }

        if(debugMode){
            console.info(
                "[webgl]",
                "MAX_FRAGMENT_UNIFORM_VECTORS=",
                gl.getParameter(
                    gl.MAX_FRAGMENT_UNIFORM_VECTORS
                ),
                "MAX_VERTEX_UNIFORM_VECTORS=",
                gl.getParameter(
                    gl.MAX_VERTEX_UNIFORM_VECTORS
                ),
                "MAX_TEXTURE_SIZE=",
                gl.getParameter(
                    gl.MAX_TEXTURE_SIZE
                )
            );
        }
    }

    updateVersionLabels();
    probeWebGLSupport();

    window.Module = {
        canvas:canvas,

        webglContextAttributes:{
            alpha:false,
            antialias:false,
            depth:true,
            stencil:true,
            preserveDrawingBuffer:false,
            powerPreference:"high-performance",
            failIfMajorPerformanceCaveat:false
        },

        preRun:[],
        postRun:[],

        locateFile:function(path){
            var version = currentVersion();
            var separator =
                path.indexOf("?") >= 0 ?
                "&" :
                "?";

            return (
                path +
                separator +
                "_v=" +
                encodeURIComponent(version)
            );
        },

        print:function(){
            console.log(
                "[stdout]",
                Array.prototype.slice
                    .call(arguments)
                    .join(" ")
            );
        },

        printErr:function(){
            console.error(
                "[stderr]",
                Array.prototype.slice
                    .call(arguments)
                    .join(" ")
            );
        },

        setStatus:function(text){
            if(debugMode && text){
                console.info(
                    "[status]",
                    text
                );
            }
        },

        monitorRunDependencies:function(){
        },

        onAbort:function(reason){
            console.error(
                "[abort]",
                reason
            );

            if(loaderText){
                loaderText.textContent =
                    "Engine aborted.";
            }
        },

        onRuntimeInitialized:function(){
            resizeCanvasCssOnly();

            if(window.spinviewActivateKeyboard){
                window.spinviewActivateKeyboard();
            }

            if(typeof window.Shell_OnLoad === "function"){
                window.Shell_OnLoad();
            }

            if(loader){
                loader.style.display = "none";
            }

            console.info(
                "[runtime] Ready."
            );
        }
    };

    if(showDebugButton){
        debugButton.classList.add("visible");
    }

    window.spinviewConsoleShow = showDebug;
    window.spinviewConsoleHide = hideDebug;
    window.spinviewConsoleToggle = toggleDebug;
})();
</script>

{{{ SCRIPT }}}

</body>
</html>